    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@workflow-pro/database": "workspace:*",
    "bullmq": "^6.7.10",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2"
  }
}
