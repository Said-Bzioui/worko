model Board {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  name        String    @db.VarChar(120)
  type        BoardType @default(KANBAN)
  filterQuery String?   @db.Text

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns BoardColumn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("boards")
}

model BoardColumn {
  id       String  @id @default(uuid()) @db.Uuid
  boardId  String  @db.Uuid
  statusId String? @db.Uuid
  name     String  @db.VarChar(80)
  position Int     @default(0)
  wipLimit Int?

  board  Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  status WorkflowStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)

  @@index([boardId, position])
  @@map("board_columns")
}

model Sprint {
  id        String       @id @default(uuid()) @db.Uuid
  projectId String       @db.Uuid
  name      String       @db.VarChar(120)
  goal      String?      @db.Text
  startDate DateTime?
  endDate   DateTime?
  status    SprintStatus @default(FUTURE)

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  SprintIssue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
  @@map("sprints")
}

model SprintIssue {
  id       String @id @default(uuid()) @db.Uuid
  sprintId String @db.Uuid
  issueId  String @db.Uuid

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  issue  Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@unique([sprintId, issueId])
  @@index([issueId])
  @@map("sprint_issues")
}
