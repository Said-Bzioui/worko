model Project {
  id               String        @id @default(uuid()) @db.Uuid
  workspaceId      String        @db.Uuid
  teamId           String?       @db.Uuid
  workflowSchemeId String?       @db.Uuid
  name             String        @db.VarChar(150)
  key              String        @db.VarChar(12)
  description      String?       @db.Text
  status           ProjectStatus @default(PLANNING)

  nextIssueNumber Int @default(1)

  startDate DateTime?
  dueDate   DateTime?

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  team           Team?           @relation(fields: [teamId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  workflowScheme WorkflowScheme? @relation(fields: [workflowSchemeId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  issues          Issue[]
  boards          Board[]
  sprints         Sprint[]
  members         ProjectMember[]
  components      ProjectComponent[]
  versions        ProjectVersion[]
  roleAssignments ProjectRoleAssignment[]
  customFields    ProjectCustomField[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, key])
  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@index([teamId])
  @@map("projects")
}

model ProjectMember {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  userId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectComponent {
  id          String  @id @default(uuid()) @db.Uuid
  projectId   String  @db.Uuid
  name        String  @db.VarChar(100)
  description String? @db.Text

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@map("project_components")
}

model ProjectVersion {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  name        String    @db.VarChar(100)
  description String?   @db.Text
  releaseDate DateTime?
  isReleased  Boolean   @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@map("project_versions")
}
