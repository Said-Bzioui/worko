model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(80)
  key         String    @unique @db.VarChar(80)
  scope       RoleScope
  description String?   @db.Text
  isSystem    Boolean   @default(false)

  permissions             RolePermission[]
  organizationAssignments OrganizationRoleAssignment[]
  workspaceAssignments    WorkspaceRoleAssignment[]
  projectAssignments      ProjectRoleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique @db.VarChar(120)
  resource    String  @db.VarChar(60)
  action      String  @db.VarChar(60)
  description String? @db.Text

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model OrganizationRoleAssignment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId         String
  roleId         String @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([organizationId, userId, roleId])
  @@index([userId])
  @@map("organization_role_assignments")
}

model WorkspaceRoleAssignment {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  userId      String
  roleId      String @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workspaceId, userId, roleId])
  @@index([userId])
  @@map("workspace_role_assignments")
}

model ProjectRoleAssignment {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  userId    String
  roleId    String @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, userId, roleId])
  @@index([userId])
  @@map("project_role_assignments")
}
