FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

FROM base AS build
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/auth-sdk/package.json packages/auth-sdk/
COPY apps/frontend_ui/package.json apps/frontend_ui/
RUN pnpm install --frozen-lockfile --filter @worko/auth-sdk... --filter frontend...

COPY packages/auth-sdk packages/auth-sdk
COPY apps/frontend_ui apps/frontend_ui
RUN pnpm --filter @worko/auth-sdk build && pnpm --filter frontend build

FROM nginx:1.27-alpine AS runner
COPY infrastructure/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/frontend_ui/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
